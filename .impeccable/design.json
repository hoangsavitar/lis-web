      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px;}.ds-chips button{min-height:44px;padding:9px 20px;border:1px solid var(--line,#deded6);border-radius:24px;background:transparent;color:var(--ink,#222220);font-size:16px;line-height:1.5;cursor:pointer;font-family:var(--font-body,\"Be Vietnam Pro\"),sans-serif;}.ds-chips button[aria-pressed=\"true\"]{background:var(--ink,#222220);border-color:var(--ink,#222220);color:#fff;}.ds-chips button:hover:not([aria-pressed=\"true\"]){background:#eeede7;}.ds-chips button:focus-visible{outline:2px solid var(--focus,#46535a);outline-offset:4px;}@media(max-width:767px){.ds-chips{gap:6px;}.ds-chips button{padding-inline:14px;}}"
