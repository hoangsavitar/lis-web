      "css": ".ds-nav{display:flex;align-items:center;flex-wrap:wrap;gap:24px;color:var(--ink,#222220);font-family:var(--font-body,\"Be Vietnam Pro\"),sans-serif;}.ds-nav a{display:flex;align-items:center;min-height:44px;font-size:16px;font-weight:500;line-height:1.65;color:inherit;text-decoration:none;}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{text-decoration:underline;text-underline-offset:7px;text-decoration-color:var(--brand,#630d1a);}.ds-nav a:focus-visible{outline:2px solid var(--focus,#46535a);outline-offset:4px;}"
