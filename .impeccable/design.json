      "html": "<label class=\"ds-search-label\" for=\"ds-search\">Tên mẫu hoặc màu</label><div class=\"ds-search-field\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z\"/></svg><input class=\"ds-search-input\" id=\"ds-search\" type=\"search\" placeholder=\"Tên mẫu hoặc màu, ví dụ: Mia, đỏ\"/></div>",
