    {
      "name": "Card sản phẩm",
      "kind": "card",
      "refersTo": "product-card",
      "description": "Card vuông, tên/chấm màu/tên màu/Hỏi giá và lưu luôn hiện. Nhúng packshot Mia Be thật; chưa có cặp lifestyle cùng variant để preview hai ảnh.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-image-wrap\"><a class=\"ds-card-image\" href=\"/products/mia-bag?variant=mia-bag-beige\" aria-label=\"Xem Mia Bag màu Be\"><img class=\"ds-card-photo\" src=\"data:image/webp;base64,\" alt=\"Mia Bag — Be\"/></a><button class=\"ds-card-save\" aria-label=\"Lưu Mia Bag màu Be\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M178,40c-20.65,0-38.73,8.88-50,23.89C116.73,48.88,98.65,40,78,40a62.07,62.07,0,0,0-62,62c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,228.66,240,172,240,102A62.07,62.07,0,0,0,178,40ZM128,214.8C109.74,204.16,32,155.69,32,102A46.06,46.06,0,0,1,78,56c19.45,0,35.78,10.36,42.6,27a8,8,0,0,0,14.8,0c6.82-16.67,23.15-27,42.6-27a46.06,46.06,0,0,1,46,46C224,155.61,146.24,204.15,128,214.8Z\"/></svg></button></div><div class=\"ds-card-info\"><a class=\"ds-card-title\" href=\"/products/mia-bag?variant=mia-bag-beige\"><h3>Mia Bag</h3></a><div class=\"ds-card-swatches\" role=\"group\" aria-label=\"Chọn màu\"><button type=\"button\" aria-label=\"Be\" aria-pressed=\"true\"><span class=\"ds-card-beige\"></span></button><button type=\"button\" aria-label=\"Nâu\" aria-pressed=\"false\"><span class=\"ds-card-brown\"></span></button><button type=\"button\" aria-label=\"Xanh bơ\" aria-pressed=\"false\"><span class=\"ds-card-avocado\"></span></button><button type=\"button\" aria-label=\"Đỏ\" aria-pressed=\"false\"><span class=\"ds-card-red\"></span></button></div><p class=\"ds-card-color\" aria-live=\"polite\">Be</p><a class=\"ds-card-contact\" href=\"https://www.facebook.com/lisbyliiofficial\" target=\"_blank\" rel=\"noopener noreferrer\">Hỏi giá</a></div></article>",
      "css": ".ds-card{min-width:0;background:transparent;color:var(--ink,#222220);font-family:var(--font-body,\"Be Vietnam Pro\"),sans-serif;}.ds-card-image{display:block;aspect-ratio:1/1;border-radius:12px;overflow:hidden;background:#eeede8;color:inherit;text-decoration:none;}.ds-card-image-wrap{position:relative;}.ds-card-photo{display:block;width:100%;height:100%;object-fit:contain;}.ds-card-save{position:absolute;top:10px;right:10px;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;border-radius:50%;background:rgba(255,255,255,.96);color:var(--ink,#222220);box-shadow:0 1px 3px #0000000c;cursor:pointer;}.ds-card-save:hover{background:#fff;color:var(--brand,#630d1a);}.ds-card-save:focus-visible{outline:2px solid var(--focus,#46535a);outline-offset:4px;}.ds-card-info{padding:12px 0 0;}.ds-card-title{display:inline-block;color:inherit;text-decoration:none;}.ds-card-title h3{margin:0;font-family:var(--font-heading,Manrope),sans-serif;font-size:22px;font-weight:600;letter-spacing:-.025em;line-height:1.4;}.ds-card-title:hover{text-decoration:underline;text-underline-offset:5px;}.ds-card-swatches{display:flex;flex-wrap:wrap;margin-top:5px;}.ds-card-swatches button{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;border-radius:8px;background:transparent;cursor:pointer;transition:background .16s;}.ds-card-swatches button:hover{background:#eaeae4;}.ds-card-swatches span{display:block;width:24px;height:24px;border-radius:50%;border:1px solid rgba(0,0,0,.15);}.ds-card-beige{background:#dfd8bd;}.ds-card-brown{background:#483032;}.ds-card-avocado{background:#9eac75;}.ds-card-red{background:#7b303c;}.ds-card-swatches button[aria-pressed=\"true\"] span{outline:1.5px solid var(--ink,#222220);outline-offset:3px;}.ds-card-swatches button:focus-visible{outline:2px solid var(--focus,#46535a);outline-offset:4px;}.ds-card-color{margin:0;color:var(--muted,#62625c);font-size:14px;line-height:1.7;}.ds-card-contact{display:inline-flex;align-items:center;min-height:44px;margin-top:3px;color:var(--brand,#630d1a);font-size:16px;font-weight:500;line-height:1.5;text-decoration:none;}.ds-card-contact:hover{text-decoration:underline;text-underline-offset:5px;}.ds-card a:focus-visible{outline:2px solid var(--focus,#46535a);outline-offset:4px;}@media(max-width:767px){.ds-card-title h3{font-size:18px;}.ds-card-color{min-height:48px;}.ds-card-save{right:6px;top:6px;}}@media(max-width:359px){.ds-card-color{min-height:0;}}@media(prefers-reduced-motion:reduce){.ds-card-swatches button{transition:none;}}"
