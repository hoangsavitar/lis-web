  "narrative": {
    "northStar": "Cửa hàng LIS",
    "overview": "Hệ thống hiện có dành phần lớn diện tích cho ảnh túi và charm thật. Nền kem, mặt trắng, chữ tối và đỏ lấy từ logo tạo một cửa hàng nhẹ, dễ đọc và dễ xem màu sản phẩm. Đây là bản ghi từ giao diện đã triển khai, dựa vào app/globals.css, app/layout.tsx và các thành phần cửa hàng.\n\nGiữ logo được người dùng cung cấp, Manrope cho tiêu đề và Be Vietnam Pro cho nội dung tiếng Việt. Nội dung và thao tác đi cùng ảnh, với vùng bấm đủ lớn và trạng thái chọn màu rõ ràng. Các cấu trúc chiến dịch riêng được ghi ở hợp đồng bề mặt; chúng không thay thế hệ thống cửa hàng chung.",
    "keyCharacteristics": [
      "Ảnh sản phẩm thật và màu đang chọn dẫn trải nghiệm.",
      "Nền kem, mặt trắng, chữ tối và đỏ thương hiệu dùng tiết chế.",
      "Tiêu đề Manrope 600, nội dung Be Vietnam Pro dễ đọc tiếng Việt.",
      "Bố cục thoáng, điều khiển có focus rõ và vùng bấm từ 44px."
    ],
    "rules": [
      {
        "name": "The Logo Source Rule",
        "body": "Dùng bản logo có alpha trong public/brand/lis/, xuất từ logo người dùng; không dựng lại chữ LIS bằng font.",
        "section": "colors"
      },
      {
        "name": "The Vietnamese Type Rule",
        "body": "Giữ cặp font có subset tiếng Việt; không thay hệ tiêu đề hoặc dùng nhãn tiếng Anh viết hoa để thêm điểm nhấn.",
        "section": "typography"
      },
      {
        "name": "The Overlay Depth Rule",
        "body": "Dùng độ nổi cho điều khiển che lên nội dung; card sản phẩm giữ nền mở và không có hộp shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do dùng logo có alpha, ảnh và tên màu thật từ catalog LIS.",
      "Do giữ Manrope 600 và Be Vietnam Pro có tiếng Việt.",
      "Do giữ vùng bấm từ 44px và vòng focus nhìn rõ trên nền hiện tại.",
      "Do giữ mọi ảnh/card theo màu đã chọn; chỉ preview lifestyle khi có cặp cùng variant và giữ primary khi ảnh thứ hai lỗi.",
      "Do áp prefers-reduced-motion cho chuyển động và scroll."
    ],
    "donts": [
      "Don't vẽ lại logo bằng font hoặc thay hệ font trong một lần sửa bề mặt.",
      "Don't thêm hộp shadow bao quanh card sản phẩm phẳng.",
      "Don't lặp hướng dẫn thao tác dài hoặc thêm nhãn tiếng Anh viết hoa làm điểm nhấn.",
      "Don't đưa bố cục của một chiến dịch thành quy tắc cho mọi trang."
    ]
